# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=secret
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=secret
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=secret

# Resend → API Keys. The "from" domain must be verified in Resend.
RESEND_API_KEY=secret
EMAIL_FROM="AvyPies Bakery <orders@yourdomain.co.za>"

# Used for links in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
